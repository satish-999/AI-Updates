# Names/placeholders only. Never commit real secrets.
# Application data (Neon pooled connection string); app AND scheduled workers.
DATABASE_URL=""

# Authentication: new Supabase project, app environment only.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
APP_URL="http://localhost:3000"
GOOGLE_AUTH_ENABLED="false"
# Leave unset in deployment. Only a loopback-only isolated preview uses "preview".
AUTH_MODE="supabase"
# Legacy local preview only:
APP_PASSWORD=""
AUTH_SECRET=""

# Optional model provider: app AND ingestion worker.
GEMINI_API_KEY=""
GROQ_API_KEY=""
LLM_DAILY_CAP="200"

# Razorpay: app AND billing reconciliation worker; start with test mode.
BILLING_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_ID=""
# App webhook only; separate from API key secret.
RAZORPAY_WEBHOOK_SECRET=""
BUSINESS_NAME=""
SUPPORT_EMAIL=""
REFUND_POLICY=""

# See DEPLOYMENT.md for SMTP, confirmation templates, OAuth, migrations,
# GitHub repository-secret scope, webhook lifecycle and rollout checks.
