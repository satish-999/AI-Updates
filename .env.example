# Copy to .env and fill in. NEVER commit .env — this repo is public.

# ---------------------------------------------------------------- worker ----
# Needed by every pipeline stage (ingest, embed, cluster, score, enrich, tidy)
# and by the app. Use the POOLED connection string: Neon dashboard → your
# project → Connect → check "Pooled connection". The pooler host carries a
# "-pooler" suffix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Stage 5 (enrich) and the agent. Both have free tiers. Gemini is tried first
# and Groq is the fallback; either alone is enough to run.
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ------------------------------------------------------------------- app ----
# The app FAILS CLOSED without both of these: proxy.ts and /api/login redirect
# to /login?error=unconfigured rather than letting anyone in. A deploy missing
# either one is a permanently locked app, so set both wherever the app runs.

# The shared sign-in password. One password for everyone — there are no
# accounts. Read state is still per browser, via the pulse_viewer cookie.
APP_PASSWORD=""

# Signs the session cookie (HMAC-SHA256). Any long random string; rotating it
# invalidates every existing session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ----------------------------------------------------------- where it goes --
# Local        → this .env file
# GitHub       → Settings → Secrets and variables → Actions:
#                DATABASE_URL, GEMINI_API_KEY, GROQ_API_KEY  (the worker)
# Vercel       → Project → Settings → Environment Variables:
#                DATABASE_URL, APP_PASSWORD, AUTH_SECRET     (the app)
#
# Optional overrides, all with working defaults — see the file that reads each:
#   LLM_DAILY_CAP (200), GEMINI_MODEL, GROQ_MODEL            src/llm.ts
#   CLUSTER_THRESHOLD (0.75), CLUSTER_MAX_AGE_DAYS (7)       src/cluster.ts
#   ENRICH_MIN_IMPORTANCE (0.5), ENRICH_MAX_PER_RUN (15)     src/enrich.ts
#   SCORE_WINDOW_HOURS (72)                                  src/score.ts
#   INGEST_DEADLINE_MS, EMBED_DEADLINE_MS                    set in CI
